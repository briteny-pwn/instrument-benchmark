{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Instrument benchmark suite",
  "type": "object",
  "additionalProperties": false,
  "required": ["suite_id", "agent", "runs", "result_path"],
  "properties": {
    "suite_id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_-]*$"
    },
    "agent": {"const": "claudecode"},
    "runs": {
      "type": "array",
      "minItems": 1,
      "items": {"type": "string", "minLength": 1}
    },
    "result_path": {"type": "string", "minLength": 1}
  }
}
