{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Source-routed instrument benchmark run",
  "type": "object",
  "additionalProperties": false,
  "required": ["run_id", "source_id", "instance_id", "report_path"],
  "properties": {
    "run_id": {"type": "string", "minLength": 1},
    "source_id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_-]*$"
    },
    "instance_id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_-]*$"
    },
    "report_path": {"type": "string", "minLength": 1}
  }
}
