{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Distributed instrument benchmark run",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "run_id",
    "instance_checkout",
    "instance_id",
    "evaluator_checkout",
    "evaluator_id",
    "candidate_path",
    "report_path",
    "timeout_seconds",
    "max_output_bytes",
    "repeated_worlds",
    "repeated_base_seed",
    "container_protocol_version",
    "image_mode"
  ],
  "properties": {
    "schema_version": {"const": 1},
    "run_id": {"type": "string", "minLength": 1},
    "instance_checkout": {"type": "string", "minLength": 1},
    "instance_id": {
      "enum": ["pyvisa_dut_validation_v1", "pyvisa_dut_validation_v2", "fibsem_liftout_v1"]
    },
    "evaluator_checkout": {"type": "string", "minLength": 1},
    "evaluator_id": {
      "enum": ["pyvisa_dut_validation_v1", "pyvisa_dut_validation_v2", "fibsem_liftout_v1"]
    },
    "candidate_path": {"type": "string", "minLength": 1},
    "report_path": {"type": "string", "minLength": 1},
    "timeout_seconds": {"type": "number", "exclusiveMinimum": 0},
    "max_output_bytes": {"type": "integer", "minimum": 1},
    "repeated_worlds": {"type": "integer", "minimum": 1},
    "repeated_base_seed": {"type": "integer", "minimum": 1},
    "container_protocol_version": {"const": 1},
    "image_mode": {"const": "locked"},
    "openfibsem_checkout": {"type": "string", "minLength": 1},
    "openfibsem_commit": {"type": "string", "pattern": "^[0-9a-f]{40}$"}
  },
  "allOf": [
    {
      "if": {
        "properties": {"evaluator_id": {"const": "fibsem_liftout_v1"}},
        "required": ["evaluator_id"]
      },
      "then": {"required": ["openfibsem_checkout", "openfibsem_commit"]},
      "else": {
        "not": {
          "anyOf": [
            {"required": ["openfibsem_checkout"]},
            {"required": ["openfibsem_commit"]}
          ]
        }
      }
    }
  ]
}
