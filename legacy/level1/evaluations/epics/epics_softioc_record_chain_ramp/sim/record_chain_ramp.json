{
  "initial_state": {"source": {"enabled": 0, "setpoint_v": 0.0, "readback_v": 0.0}, "process": {"history": []}},
  "resources": [
    {
      "name": "IOC::RAMPCHAIN::SIM",
      "commands": [
        {"kind": "query", "command": "*IDN?", "response": "EPICSIM,SoftIocRampChain,IOC-RAMP-01,1.0"},
        {"kind": "write", "command": "PSU:ENABLE 1", "state_updates": {"source.enabled": 1}, "state_appends": {"process.history": "bo:enable"}},
        {"kind": "write", "command": "PSU:ENABLE 0", "state_updates": {"source.enabled": 0}},
        {
          "kind": "write", "command_regex": "^PSU:SET ([-+0-9.]+)$", "requires_state": {"source.enabled": 1},
          "state_appends": {"process.history": "ao:setpoint"}, "state_from_groups": {
            "source.setpoint_v": {"group": 1, "type": "float"},
            "source.readback_v": {"group": 1, "type": "float", "scale": 1.0, "offset": 0.01, "round": 6}
          }
        },
        {"kind": "query", "command_regex": "^DMM:READ\\? [-+0-9.]+$", "requires_state": {"source.enabled": 1}, "state_appends": {"process.history": ["ai:readback", "calc:error"]}, "response_template": "READ {source.readback_v} V"},
        {"kind": "query", "command": "RECORDS?", "requires_state": {"source.enabled": 0}, "state_appends": {"process.history": "bi:alarm"}, "response_template": "RECORDS {process.history}"}
      ]
    }
  ]
}
