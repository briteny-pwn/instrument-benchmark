{
  "initial_state": {"pv": {"setpoint_v": 0.0, "readback_v": 0.0, "detector_count": 0, "has_write": false}},
  "resources": [
    {
      "name": "CA::PVBRIDGE::SIM",
      "commands": [
        {"kind": "query", "command": "*IDN?", "response": "EPICSIM,CaprotoPvBridge,PV-BRIDGE-01,1.0"},
        {
          "kind": "write", "command_regex": "^PVPUT MOCK:BIAS:SP ([-+0-9.]+)$", "state_updates": {"pv.has_write": true},
          "state_from_groups": {
            "pv.setpoint_v": {"group": 1, "type": "float"},
            "pv.readback_v": {"group": 1, "type": "float", "scale": 0.995, "offset": 0.001, "round": 6},
            "pv.detector_count": {"group": 1, "type": "int", "scale": 232.0, "offset": 149.0}
          }
        },
        {"kind": "query", "command": "PVGET MOCK:BIAS:SP", "requires_state": {"pv.has_write": true}, "response_template": "MOCK:BIAS:SP {pv.setpoint_v}"},
        {"kind": "query", "command": "PVGET MOCK:BIAS:RBV", "requires_state": {"pv.has_write": true}, "response_template": "MOCK:BIAS:RBV {pv.readback_v}"},
        {"kind": "query", "command": "PVGET MOCK:DETECTOR:COUNT", "requires_state": {"pv.has_write": true}, "response_template": "MOCK:DETECTOR:COUNT {pv.detector_count}"},
        {"kind": "query", "command": "MONITOR? MOCK:BIAS:SP", "requires_state": {"pv.has_write": true}, "response_template": "BIAS:SP={pv.setpoint_v}"}
      ]
    }
  ]
}
