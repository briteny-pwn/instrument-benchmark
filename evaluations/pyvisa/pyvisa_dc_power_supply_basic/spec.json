{
  "instance_id": "pyvisa_dc_power_supply_basic",
  "simulator": "pyvisa_sim/mockdp100.yaml",
  "expected_result": {
    "instrument": "MockDP100",
    "channel": 1,
    "target_voltage_v": {"close": 3.3, "abs_tol": 1e-6},
    "current_limit_a": {"close": 0.5, "abs_tol": 1e-6},
    "measured_voltage_v": {"range": [3.25, 3.35]},
    "output_enabled": true
  },
  "raw_protocol": {
    "expected_resources": ["USB0::0x9999::0x0001::DP100001::INSTR"],
    "expected_commands": [
      {"kind": "query", "command": "*IDN?"},
      {"kind": "write", "command": ":SOURce1:VOLTage 3.3"},
      {"kind": "write", "command": ":SOURce1:CURRent 0.5"},
      {"kind": "write", "command": ":OUTPut CH1,ON"},
      {"kind": "query", "command": ":MEASure:VOLTage? CH1"}
    ],
    "expected_sequence": [
      {"kind": "write", "command": ":SOURce1:VOLTage 3.3"},
      {"kind": "write", "command": ":SOURce1:CURRent 0.5"},
      {"kind": "write", "command": ":OUTPut CH1,ON"},
      {"kind": "query", "command": ":MEASure:VOLTage? CH1"}
    ]
  }
}
