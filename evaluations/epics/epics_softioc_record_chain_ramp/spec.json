{
  "instance_id": "epics_softioc_record_chain_ramp",
  "spec_version": 2,
  "gateway": "state_machine",
  "authoring": {"base_simulator": "sim/record_chain_ramp.json", "seed": "record-ramp-authoring-v1"},
  "pass_threshold": 0.85,
  "rubric": {
    "sim_execution": 0.05, "forbidden_api": 0.10, "task_success": 0.40,
    "instrument_access": 0.15, "protocol_correctness": 0.10,
    "state_process": 0.10, "safety_and_cleanup": 0.10
  },
  "suite": {"robustness_weight": 0.20, "minimum_pass_rate": 1.0, "repetitions": 1},
  "scenarios": [
    {"id": "nominal_offset", "simulator": "sim/record_chain_ramp.json"},
    {"id": "low_gain_within_tolerance", "simulator": "sim/record_chain_ramp_low_gain.json"},
    {"id": "gain_drift_alarm", "simulator": "sim/record_chain_ramp_alarm.json"}
  ],
  "gates": [
    {"dimension": "forbidden_api", "min": 1.0},
    {"dimension": "instrument_access", "min": 1.0},
    {"check": "readback_trace_oracle", "min": 1.0},
    {"check": "error_array_oracle", "min": 1.0},
    {"check": "max_error_oracle", "min": 1.0},
    {"check": "alarm_oracle", "min": 1.0},
    {"check": "record_history_oracle", "min": 1.0},
    {"check": "ramp_record_process", "min": 1.0},
    {"check": "source_safe_state", "min": 1.0},
    {"check": "cleanup", "min": 1.0}
  ],
  "checks": [
    {
      "name": "result_contract", "type": "result_json", "dimension": "task_success",
      "expected": {
        "instrument": "SoftIocRampChain",
        "setpoints_v": [0.0, 1.0, 2.0, 3.0]
      }
    },
    {
      "name": "identity_oracle", "type": "trace_response", "dimension": "task_success",
      "selector": {"kind": "query", "command": "*IDN?"}, "parse": "csv_field", "field_index": 1,
      "expected": "SoftIocRampChain", "result_path": "$.instrument"
    },
    {
      "name": "record_history_oracle", "type": "trace_response", "dimension": "task_success",
      "selector": {"kind": "query", "command": "RECORDS?"},
      "parse": "prefixed_csv", "prefix": "RECORDS ",
      "expected": [
        "bo:enable",
        "ao:setpoint", "ai:readback", "calc:error",
        "ao:setpoint", "ai:readback", "calc:error",
        "ao:setpoint", "ai:readback", "calc:error",
        "ao:setpoint", "ai:readback", "calc:error",
        "bi:alarm"
      ],
      "result_path": "$.processed_records"
    },
    {
      "name": "readback_trace_oracle", "type": "trace_numeric_aggregate", "dimension": "task_success",
      "selector": {"kind": "query", "command_prefix": "DMM:READ?"},
      "response_regex": "^READ\\s+([-+0-9.eE]+)\\s+V$",
      "assertions": [{"result_path": "$.readbacks_v", "aggregate": "values", "abs_tol": 1e-9}]
    },
    {
      "name": "error_array_oracle", "type": "result_pairwise_differences", "dimension": "task_success",
      "left_path": "$.setpoints_v", "right_path": "$.readbacks_v", "result_path": "$.errors_v", "abs_tol": 1e-9
    },
    {
      "name": "max_error_oracle", "type": "result_pairwise_max_abs_error", "dimension": "task_success",
      "left_path": "$.setpoints_v", "right_path": "$.readbacks_v", "result_path": "$.max_abs_error_v", "abs_tol": 1e-9
    },
    {
      "name": "alarm_oracle", "type": "result_threshold_decision", "dimension": "task_success",
      "result_path": "$.alarm", "true_value": "NO_ALARM", "false_value": "HIGH",
      "conditions": [{"path": "$.max_abs_error_v", "max": 0.05}]
    },
    {"name": "final_setpoint_state", "type": "sim_state", "dimension": "task_success", "path": "$.state.source.setpoint_v", "expected": {"close": 3.0, "abs_tol": 1e-9}},
    {"name": "source_safe_state", "type": "sim_state", "dimension": "safety_and_cleanup", "path": "$.state.source.enabled", "expected": 0},
    {
      "name": "raw_interface_evidence", "type": "trace_coverage", "dimension": "instrument_access",
      "expectations": [{"kind": "socket_connect"}, {"kind": "list_resources"}, {"kind": "open"}, {"kind": "query", "command": "*IDN?"}]
    },
    {
      "name": "protocol_commands", "type": "trace_coverage", "dimension": "protocol_correctness",
      "expectations": [
        {"kind": "write", "command": "PSU:ENABLE 1"},
        {"kind": "write", "command_regex": "^PSU:SET 0(?:\\.0*)?$"},
        {"kind": "write", "command_regex": "^PSU:SET 3(?:\\.0*)?$"},
        {"kind": "query", "command_prefix": "DMM:READ?"},
        {"kind": "write", "command": "PSU:ENABLE 0"},
        {"kind": "query", "command": "RECORDS?"}
      ]
    },
    {
      "name": "ramp_record_process", "type": "ordered_milestones", "dimension": "state_process",
      "milestones": [
        {"kind": "write", "command": "PSU:ENABLE 1"},
        {"kind": "write", "command_regex": "^PSU:SET 0(?:\\.0*)?$"}, {"kind": "query", "command_regex": "^DMM:READ\\? 0(?:\\.0*)?$"},
        {"kind": "write", "command_regex": "^PSU:SET 1(?:\\.0*)?$"}, {"kind": "query", "command_regex": "^DMM:READ\\? 1(?:\\.0*)?$"},
        {"kind": "write", "command_regex": "^PSU:SET 2(?:\\.0*)?$"}, {"kind": "query", "command_regex": "^DMM:READ\\? 2(?:\\.0*)?$"},
        {"kind": "write", "command_regex": "^PSU:SET 3(?:\\.0*)?$"}, {"kind": "query", "command_regex": "^DMM:READ\\? 3(?:\\.0*)?$"},
        {"kind": "write", "command": "PSU:ENABLE 0"},
        {"kind": "query", "command": "RECORDS?"}
      ]
    },
    {"name": "anti_hardcode", "type": "anti_hardcode", "dimension": "instrument_access", "requires": ["socket_connect", "list_resources", "open", "write", "query"]},
    {"name": "cleanup", "type": "cleanup", "dimension": "safety_and_cleanup"}
  ]
}
