{
  "initial_state": {
    "loop": {"setpoint_c": 15.0, "heater_range": "OFF", "temperature_c": 25.0, "heater_percent": 0.0, "status": "IDLE"}
  },
  "resources": [
    {
      "name": "TCPIP0::10.10.0.33::4201::SOCKET",
      "commands": [
        {"kind": "query", "command": "*IDN?", "response": "EPICSIM,TempLoop336,TC336SLOW,1.2"},
        {"kind": "write", "command_regex": "^SETP 1,([-+0-9.]+)$", "state_from_groups": {"loop.setpoint_c": {"group": 1, "type": "float"}}},
        {"kind": "write", "command_regex": "^RANGE 1,(OFF|LOW|MED|HIGH)$", "state_from_groups": {"loop.heater_range": {"group": 1, "type": "str"}}},
        {"kind": "query", "command": "SETP? 1", "response_template": "SETP 1,{loop.setpoint_c}"},
        {"kind": "query", "command": "RANGE? 1", "response_template": "RANGE 1,{loop.heater_range}"},
        {
          "kind": "query", "command": "KRDG? A", "requires_state": {"loop.setpoint_c": 37.0, "loop.heater_range": "MED"},
          "steps": [
            {"response": "TEMP 25.00 C", "state_updates": {"loop.temperature_c": 25.0}},
            {"response": "TEMP 32.50 C", "state_updates": {"loop.temperature_c": 32.5}},
            {"response": "TEMP 35.90 C", "state_updates": {"loop.temperature_c": 35.9}},
            {"response": "TEMP 37.18 C", "state_updates": {"loop.temperature_c": 37.18}},
            {"response": "TEMP 37.07 C", "state_updates": {"loop.temperature_c": 37.07}},
            {"response": "TEMP 36.99 C", "state_updates": {"loop.temperature_c": 36.99}}
          ]
        },
        {
          "kind": "query", "command": "HTR? 1", "requires_state": {"loop.setpoint_c": 37.0, "loop.heater_range": "MED"},
          "steps": [
            {"response": "HTR 1,76.0 %", "state_updates": {"loop.heater_percent": 76.0}},
            {"response": "HTR 1,51.0 %", "state_updates": {"loop.heater_percent": 51.0}},
            {"response": "HTR 1,29.0 %", "state_updates": {"loop.heater_percent": 29.0}},
            {"response": "HTR 1,18.0 %", "state_updates": {"loop.heater_percent": 18.0}},
            {"response": "HTR 1,14.0 %", "state_updates": {"loop.heater_percent": 14.0}},
            {"response": "HTR 1,11.2 %", "state_updates": {"loop.heater_percent": 11.2}}
          ]
        },
        {
          "kind": "query", "command": "STB?", "requires_state": {"loop.setpoint_c": 37.0, "loop.heater_range": "MED"},
          "steps": [
            {"response": "LOOP RAMPING", "state_updates": {"loop.status": "RAMPING"}},
            {"response": "LOOP RAMPING", "state_updates": {"loop.status": "RAMPING"}},
            {"response": "LOOP RAMPING", "state_updates": {"loop.status": "RAMPING"}},
            {"response": "LOOP RAMPING", "state_updates": {"loop.status": "RAMPING"}},
            {"response": "LOOP RAMPING", "state_updates": {"loop.status": "RAMPING"}},
            {"response": "LOOP STABLE", "state_updates": {"loop.status": "STABLE"}}
          ]
        }
      ]
    }
  ]
}
