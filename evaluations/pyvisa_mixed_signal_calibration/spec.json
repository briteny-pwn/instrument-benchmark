{
  "instance_id": "pyvisa_mixed_signal_calibration",
  "simulator": "pyvisa_sim/mixed_signal_bench.yaml",
  "expected_result": {
    "instruments": {
      "awg": "MockAWG700",
      "scope": "MockScope900",
      "dmm": "MockDMM650"
    },
    "resources": {
      "awg": "USB0::0x9999::0x0700::AWG700001::0::INSTR",
      "scope": "TCPIP0::203.0.113.90::inst0::INSTR",
      "dmm": "GPIB0::22::INSTR"
    },
    "awg_waveform": "CAL_RAMP",
    "awg_points": [-0.5, -0.25, 0.0, 0.25, 0.5],
    "dmm_samples_v": [1.198, 1.201, 1.2, 1.199],
    "dmm_average_v": {"close": 1.1995, "abs_tol": 1e-9},
    "scope_raw_codes": [80, 95, 110, 95, 80, 65, 50, 65],
    "scope_voltages_v": [0.0, 0.3, 0.6, 0.3, 0.0, -0.3, -0.6, -0.3],
    "scope_peak_to_peak_v": {"close": 1.2, "abs_tol": 1e-9},
    "calibration_passed": true
  },
  "access": {
    "require_resource_discovery": true,
    "expected_resources": [
      "USB0::0x9999::0x0700::AWG700001::0::INSTR",
      "TCPIP0::203.0.113.90::inst0::INSTR",
      "GPIB0::22::INSTR"
    ],
    "communication": {
      "timeout": 12000,
      "read_termination": "\n",
      "write_termination": "\n"
    },
    "transfer_expectations": [
      {
        "kind": "write_ascii_values",
        "resource_name": "USB0::0x9999::0x0700::AWG700001::0::INSTR",
        "command": "DATA:ARB CAL_RAMP,",
        "values": [-0.5, -0.25, 0.0, 0.25, 0.5]
      },
      {
        "kind": "query_ascii_values",
        "resource_name": "GPIB0::22::INSTR",
        "command": "READ:VOLT?",
        "kwargs": {"separator": ";"}
      },
      {
        "kind": "query_binary_values",
        "resource_name": "TCPIP0::203.0.113.90::inst0::INSTR",
        "command": "CURVE?",
        "kwargs": {"datatype": "B", "expect_termination": false, "chunk_size": 4}
      }
    ]
  }
}
