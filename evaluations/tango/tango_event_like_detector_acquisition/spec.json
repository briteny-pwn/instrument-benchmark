{
  "instance_id": "tango_event_like_detector_acquisition",
  "spec_version": 2,
  "gateway": "state_machine",
  "authoring": {"materialized": true, "base_simulator": "sim/detector_acquisition.json", "seed": "detector-authoring-v1"},
  "pass_threshold": 0.85,
  "rubric": {"sim_execution": 0.05, "forbidden_api": 0.10, "task_success": 0.40, "instrument_access": 0.15, "protocol_correctness": 0.10, "state_process": 0.10, "safety_and_cleanup": 0.10},
  "suite": {"robustness_weight": 0.20, "minimum_pass_rate": 1.0, "repetitions": 1},
  "scenarios": [
    {"id": "nominal_signal", "simulator": "sim/detector_acquisition.json"},
    {"id": "signed_low_signal", "simulator": "sim/detector_acquisition_low_signal.json"},
    {"id": "scientific_high_dynamic_signal", "simulator": "sim/detector_acquisition_high_dynamic.json"}
  ],
  "gates": [
    {"dimension": "forbidden_api", "min": 1.0}, {"dimension": "instrument_access", "min": 1.0},
    {"check": "frame_index_oracle", "min": 1.0}, {"check": "intensity_oracle", "min": 1.0},
    {"check": "frame_count_binding", "min": 1.0}, {"check": "final_state_binding", "min": 1.0},
    {"check": "acquisition_process", "min": 1.0}, {"check": "cleanup", "min": 1.0}
  ],
  "checks": [
    {"name": "result_contract", "type": "result_json", "dimension": "task_success", "expected": {"class": "SimDetector", "exposure_s": {"close": 0.05, "abs_tol": 1e-12}, "frames": [1, 2, 3, 4], "frame_count": 4, "final_state": "ON"}},
    {"name": "class_oracle", "type": "trace_response", "dimension": "task_success", "selector": {"kind": "query", "command": "COMMAND info"}, "parse": "regex_group", "response_regex": "^CLASS\\s+(\\S+)\\s+DEVICE\\s+(\\S+)$", "group": 1, "expected": "SimDetector", "result_path": "$.class"},
    {"name": "device_oracle", "type": "trace_response", "dimension": "task_success", "selector": {"kind": "query", "command": "COMMAND info"}, "parse": "regex_group", "response_regex": "^CLASS\\s+(\\S+)\\s+DEVICE\\s+(\\S+)$", "group": 2, "result_path": "$.device"},
    {"name": "frame_index_oracle", "type": "trace_numeric_aggregate", "dimension": "task_success", "selector": {"kind": "query", "command": "READ_EVENT frame"}, "response_regex": "^FRAME\\s+(\\d+)\\s+INTENSITY\\s+[-+0-9.eE]+$", "assertions": [{"result_path": "$.frames", "aggregate": "values", "abs_tol": 1e-9}]},
    {"name": "intensity_oracle", "type": "trace_numeric_aggregate", "dimension": "task_success", "selector": {"kind": "query", "command": "READ_EVENT frame"}, "response_regex": "^FRAME\\s+\\d+\\s+INTENSITY\\s+([-+0-9.eE]+)$", "assertions": [{"result_path": "$.intensities", "aggregate": "values", "abs_tol": 1e-9}, {"result_path": "$.mean_intensity", "aggregate": "mean", "abs_tol": 1e-9}]},
    {"name": "frame_count_binding", "type": "result_sim_state_binding", "dimension": "task_success", "result_path": "$.frame_count", "sim_path": "$.state.detector.frame_count"},
    {"name": "mean_state_binding", "type": "result_sim_state_binding", "dimension": "task_success", "result_path": "$.mean_intensity", "sim_path": "$.state.detector.mean_intensity", "abs_tol": 1e-9},
    {"name": "final_state_binding", "type": "result_sim_state_binding", "dimension": "task_success", "result_path": "$.final_state", "sim_path": "$.state.detector.state"},
    {"name": "raw_interface_evidence", "type": "trace_coverage", "dimension": "instrument_access", "expectations": [{"kind": "socket_connect"}, {"kind": "list_resources"}, {"kind": "open"}, {"kind": "query", "command": "COMMAND info"}]},
    {"name": "protocol_commands", "type": "trace_coverage", "dimension": "protocol_correctness", "expectations": [{"kind": "write", "command_regex": "^WRITE_ATTR EXPOSURE 0\\.05(?:0*)?$"}, {"kind": "query", "command": "COMMAND StartAcquisition 4"}, {"kind": "query", "command": "READ_EVENT frame"}, {"kind": "query", "command": "READ_ATTR frame_count"}, {"kind": "query", "command": "READ_ATTR mean_intensity"}]},
    {"name": "acquisition_process", "type": "ordered_milestones", "dimension": "state_process", "milestones": [{"kind": "write", "command_regex": "^WRITE_ATTR EXPOSURE 0\\.05(?:0*)?$"}, {"kind": "query", "command": "COMMAND StartAcquisition 4"}, {"kind": "query", "command": "READ_EVENT frame"}, {"kind": "query", "command": "READ_EVENT frame"}, {"kind": "query", "command": "READ_EVENT frame"}, {"kind": "query", "command": "READ_EVENT frame"}, {"kind": "query", "command": "COMMAND State"}, {"kind": "query", "command": "READ_ATTR frame_count"}, {"kind": "query", "command": "READ_ATTR mean_intensity"}]},
    {"name": "anti_hardcode", "type": "anti_hardcode", "dimension": "instrument_access", "requires": ["socket_connect", "list_resources", "open", "write", "query"]},
    {"name": "cleanup", "type": "cleanup", "dimension": "safety_and_cleanup"}
  ]
}
