{
  "instance_id": "tango_motor_attribute_command_scan",
  "spec_version": 2,
  "gateway": "state_machine",
  "authoring": {"materialized": true, "base_simulator": "sim/motor_scan.json", "seed": "motor-authoring-v1"},
  "pass_threshold": 0.85,
  "rubric": {"sim_execution": 0.05, "forbidden_api": 0.10, "task_success": 0.40, "instrument_access": 0.15, "protocol_correctness": 0.10, "state_process": 0.10, "safety_and_cleanup": 0.10},
  "suite": {"robustness_weight": 0.20, "minimum_pass_rate": 1.0, "repetitions": 1},
  "scenarios": [
    {"id": "one_busy_poll_per_move", "simulator": "sim/motor_scan.json"},
    {"id": "immediate_completion", "simulator": "sim/motor_scan_immediate.json"},
    {"id": "variable_completion_delay", "simulator": "sim/motor_scan_variable_delay.json"}
  ],
  "gates": [
    {"dimension": "forbidden_api", "min": 1.0}, {"dimension": "instrument_access", "min": 1.0},
    {"check": "position_trace_oracle", "min": 1.0}, {"check": "position_error_oracle", "min": 1.0},
    {"check": "stopped_state_binding", "min": 1.0}, {"check": "motor_scan_process", "min": 1.0},
    {"check": "cleanup", "min": 1.0}
  ],
  "checks": [
    {"name": "result_contract", "type": "result_json", "dimension": "task_success", "expected": {"class": "SimuMotor", "velocity_mm_s": {"close": 2.0, "abs_tol": 1e-12}, "target_positions_mm": [0.0, 1.5, -0.5], "final_state": "ON", "stopped": true}},
    {"name": "class_oracle", "type": "trace_response", "dimension": "task_success", "selector": {"kind": "query", "command": "COMMAND info"}, "parse": "regex_group", "response_regex": "^CLASS\\s+(\\S+)\\s+DEVICE\\s+(\\S+)$", "group": 1, "expected": "SimuMotor", "result_path": "$.class"},
    {"name": "device_oracle", "type": "trace_response", "dimension": "task_success", "selector": {"kind": "query", "command": "COMMAND info"}, "parse": "regex_group", "response_regex": "^CLASS\\s+(\\S+)\\s+DEVICE\\s+(\\S+)$", "group": 2, "result_path": "$.device"},
    {"name": "position_trace_oracle", "type": "trace_numeric_aggregate", "dimension": "task_success", "selector": {"kind": "query", "command": "READ_ATTR position"}, "response_regex": "^POSITION\\s+([-+0-9.eE]+)\\s+MM$", "assertions": [{"result_path": "$.readback_positions_mm", "aggregate": "values", "abs_tol": 1e-9}]},
    {"name": "position_error_oracle", "type": "result_pairwise_max_abs_error", "dimension": "task_success", "left_path": "$.target_positions_mm", "right_path": "$.readback_positions_mm", "result_path": "$.max_abs_error_mm", "abs_tol": 1e-9},
    {"name": "velocity_state_binding", "type": "result_sim_state_binding", "dimension": "task_success", "result_path": "$.velocity_mm_s", "sim_path": "$.state.motor.velocity_mm_s"},
    {"name": "final_position_state", "type": "sim_state", "dimension": "task_success", "path": "$.state.motor.position_mm", "expected": {"close": -0.5, "abs_tol": 1e-9}},
    {"name": "stopped_state_binding", "type": "result_sim_state_binding", "dimension": "safety_and_cleanup", "result_path": "$.stopped", "sim_path": "$.state.motor.stopped"},
    {"name": "raw_interface_evidence", "type": "trace_coverage", "dimension": "instrument_access", "expectations": [{"kind": "socket_connect"}, {"kind": "list_resources"}, {"kind": "open"}, {"kind": "query", "command": "COMMAND info"}]},
    {"name": "protocol_commands", "type": "trace_coverage", "dimension": "protocol_correctness", "expectations": [{"kind": "query", "command": "COMMAND On"}, {"kind": "write", "command_regex": "^WRITE_ATTR VELOCITY 2(?:\\.0*)?$"}, {"kind": "query", "command": "READ_ATTR velocity"}, {"kind": "query", "command_regex": "^COMMAND MOVE 1\\.5(?:0*)?$"}, {"kind": "query", "command": "COMMAND State"}, {"kind": "query", "command": "READ_ATTR position"}, {"kind": "query", "command": "COMMAND Stop"}]},
    {"name": "motor_scan_process", "type": "ordered_milestones", "dimension": "state_process", "milestones": [{"kind": "query", "command": "COMMAND On"}, {"kind": "write", "command_regex": "^WRITE_ATTR VELOCITY 2(?:\\.0*)?$"}, {"kind": "query", "command_regex": "^COMMAND MOVE 0(?:\\.0*)?$"}, {"kind": "query", "command": "COMMAND State"}, {"kind": "query", "command": "READ_ATTR position"}, {"kind": "query", "command_regex": "^COMMAND MOVE 1\\.5(?:0*)?$"}, {"kind": "query", "command": "COMMAND State"}, {"kind": "query", "command": "READ_ATTR position"}, {"kind": "query", "command_regex": "^COMMAND MOVE -0\\.5(?:0*)?$"}, {"kind": "query", "command": "COMMAND State"}, {"kind": "query", "command": "READ_ATTR position"}, {"kind": "query", "command": "COMMAND Stop"}]},
    {"name": "anti_hardcode", "type": "anti_hardcode", "dimension": "instrument_access", "requires": ["socket_connect", "list_resources", "open", "write", "query"]},
    {"name": "cleanup", "type": "cleanup", "dimension": "safety_and_cleanup"}
  ]
}
